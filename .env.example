# Gatelog Server Setup reads these from the Windows environment (it does not load .env files).
# Set them with `setx NAME value` (or System Properties > Environment Variables) and restart the app.
# Names only: never commit real values.

# Update channel (Update step). Leave GATELOG_UPDATE_BUCKET unset to disable update checks.
GATELOG_UPDATE_BUCKET=
GATELOG_UPDATE_REGION=
GATELOG_UPDATE_PREFIX=

# AWS credentials with read access to the bucket, via the standard AWS SDK chain
# (or use AWS_PROFILE with a shared credentials file).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# ClickOnce publishing (Properties/PublishProfiles/VLMS installer.pubxml)
GATELOG_INSTALL_URL=
GATELOG_CERT_THUMBPRINT=
